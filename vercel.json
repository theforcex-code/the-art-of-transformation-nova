{
 "rewrites": [
  {
   "source": "/api/selecao",
   "destination": "/selecao.json"
  },
  {
   "source": "/",
   "destination": "/apresentacao.html"
  }
 ],
 "headers": [
  {
   "source": "/(.*)",
   "headers": [
    {
     "key": "X-Robots-Tag",
     "value": "noindex"
    }
   ]
  },
  {
   "source": "/(.*)\\.(mp4|jpg|jpeg|png|webp)",
   "headers": [
    {
     "key": "Cache-Control",
     "value": "public, max-age=3600"
    }
   ]
  }
 ]
}